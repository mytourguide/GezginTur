# --- Backend (backend/.env veya ortam degiskenleri) ---
ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seyahat?sslmode=disable
JWT_SECRET=uzun-rastgele-bir-dizi-degistir
# KVKK sifreleme anahtari: openssl rand -base64 32 ile uretin
DATA_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:3000
WEBHOOK_SECRET=webhook-sirli-anahtar

# iyzico sandbox anahtarlari (https://sandbox-merchant.iyzipay.com)
IYZICO_API_KEY=sandbox-anahtar
IYZICO_SECRET_KEY=sandbox-gizli-anahtar
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# SMTP (MailHog ile test: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=rezervasyon@example.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- S3 uyumlu object storage (MinIO/AWS/Spaces) — imzali gorsel yukleme ---
# MinIO ile test: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data
S3_ENDPOINT=http://localhost:9000        # bos birakilirsa AWS endpoint kullanilir
S3_REGION=eu-central-1
S3_BUCKET=seyahat-gorseller
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/seyahat-gorseller

# Sosyal giris
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_SERVICE_ID=
