// Cloudflare Workers (OpenNext) ayarlari.
// `npx @opennextjs/cloudflare build/deploy` bu dosyayi okur.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gezginTur",
  "account_id": "1e850537f63c205fc1c95e290359c50c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Runtime ortam degiskenleri (gizli olmayanlar). Sirlar icin: wrangler secret put
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://seyahat-api-hd8u.onrender.com/api/v1",
    "API_INTERNAL_URL": "https://seyahat-api-hd8u.onrender.com"
  }
}
